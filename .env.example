# Telegram delivery for quote requests.
# Both values are server-only. Never prefix with NEXT_PUBLIC_.
#
# 1. In Telegram, message @BotFather and send /newbot. Copy the token it gives you.
TELEGRAM_BOT_TOKEN=

# 2. Send any message to your new bot from the admin account, then run:
#      curl "https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates"
#    Read message.chat.id from the response and paste it here.
TELEGRAM_ADMIN_CHAT_ID=
